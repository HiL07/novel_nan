# syntax=docker/dockerfile:1
# =====================================================================
# Dockerfile for the Python AI service (FastAPI) / Python AI 服务镜像
# python-service: text extraction / analysis + async job API
#                小说文本提取、分析与异步任务接口
#
# Build context = repository root / 构建上下文 = 仓库根目录
# Build / 构建:
#   docker build -f docker/Dockerfile.python -t nan-novel-python .
#
# 说明 / NOTE:
#   - 容器内不安装 GPU / CUDA / PyTorch，也不需要宿主机显卡配置。
#     No GPU / CUDA / PyTorch inside the container, and no host GPU setup.
#   - 只安装 python-service/requirements.txt（文本提取 + 远程大模型客户端）。
#     Installs python-service/requirements.txt only (extraction + remote LLM client).
#   - 依赖使用 uv 安装（官方 uv 镜像中的二进制，安装更快、行为可复现）。
#     Dependencies are installed with uv (binary copied from the official image).
# =====================================================================

FROM python:3.11-slim AS runtime
WORKDIR /app

# Copy the uv binary from the official image (no pip bootstrap needed).
# 从官方镜像复制 uv 二进制，无需先用 pip 安装 uv。
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    # Install into the system interpreter of this image.
    # 安装到镜像自带的系统解释器。
    UV_SYSTEM_PYTHON=1 \
    UV_COMPILE_BYTECODE=1 \
    # Copy instead of symlink (safe across Docker layers).
    # 使用复制而非软链接（跨 Docker 层更安全）。
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    # Shared data dir (this service writes novels/ only; see data/README.md).
    # 共享数据目录（本服务只写 novels/，见 data/README.md）。
    DATA_DIR=/data \
    # Where base models / LoRA adapters / jobs are persisted (unchanged).
    # 基础模型 / LoRA 适配器 / 任务的持久化目录（不变）。
    LOCAL_MODELS_DIR=/data/models

# Install the lightweight service dependencies first (better caching).
# 先安装轻量服务依赖（利用构建缓存）。
COPY python-service/requirements.txt /tmp/requirements.txt
RUN uv pip install -r /tmp/requirements.txt

# Application package (only the app/ tree is needed at runtime).
# 应用代码（运行时只需要 app/ 目录）。
COPY python-service/app ./app

# Persistent data directories owned by the non-root user (app creates
# sub-directories on import, so the parent must be writable).
# 持久化数据目录，归属非 root 用户（应用会在导入时创建子目录，父目录必须可写）。
# UID/GID 10001 matches the backend image: both write the shared /data volume.
# UID/GID 10001 与后端镜像一致：双方共享 /data 数据卷。
RUN mkdir -p /data/models /data/novels \
    && groupadd --system --gid 10001 pyapp && useradd --system --gid pyapp --uid 10001 pyapp \
    && chown -R pyapp:pyapp /data
USER pyapp

# Uvicorn serves the FastAPI app on 8021 (same port as local development).
# Uvicorn 在 8021 端口提供 FastAPI 服务（与本地开发端口一致）。
EXPOSE 8021

# HTTP health check against the service's own health endpoint.
# 针对服务自身健康接口的 HTTP 健康检查。
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8021/api/health', timeout=5).status==200 else 1)" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8021"]
