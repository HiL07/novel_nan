# =====================================================================
# Environment variables for the nan_novel Docker stack
# nan_novel Docker 编排的环境变量
#
# Copy this file to ".env" and change every value marked CHANGE.
# 复制本文件为 .env，并修改所有标注 CHANGE 的值。
#   cp .env.example .env
#
# NEVER commit the real .env / 切勿提交真实的 .env（已在 .gitignore）
# =====================================================================

# --- MySQL root password (CHANGE!) / MySQL root 密码（必须修改！）---
# Used both for the MySQL container and the backend connection.
# 同时用于 MySQL 容器初始化和后端连接。
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password

# Database name (the Spring app auto-creates tables on first startup).
# 数据库名（后端首次启动时自动建表，脚本均为 CREATE TABLE IF NOT EXISTS）。
MYSQL_DATABASE=test10000

# Host port for MySQL. 3307 avoids a clash with a local MySQL on 3306.
# Set 3306 on a clean server, or remove the ports entry in compose.yaml
# to keep MySQL private to the Docker network.
# MySQL 宿主机端口。3307 可避免与本机 3306 的 MySQL 冲突；
# 干净服务器可设为 3306；不想对外暴露可在 compose.yaml 删除 ports。
MYSQL_PORT=3307

# --- Web entry port (nginx -> Vue app) / Web 入口端口（nginx -> 前端）---
# Open this port in the firewall / 防火墙需放行此端口。
FRONTEND_PORT=8080

# --- Optional: default remote LLM API key / 可选：默认远程大模型 Key ---
# Leave empty to configure models later in the web UI (模型配置 page).
# 留空即可，之后在网页「模型配置」页面填写；不要把真实 Key 写在这里并提交。
DEEPSEEK_API_KEY=
