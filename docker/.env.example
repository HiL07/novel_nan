# =====================================================================
# Environment variables for the nan_novel Docker stack
# nan_novel Docker 编排的环境变量
#
# Copy this file to ".env" and change every value marked CHANGE.
# 复制本文件为 .env，并修改所有标注 CHANGE 的值。
#   cp .env.example .env
#
# NEVER commit the real .env / 切勿提交真实的 .env（已在 .gitignore）
# =====================================================================

# --- Database / 数据库 ---
# No database server is needed: the backend uses SQLite (nan_novel.db) inside
# the shared "nan-data" volume, together with uploads and extraction results.
# 不再需要数据库服务：后端使用 SQLite（nan_novel.db），与上传文件、提取结果一起
# 存放在共享数据卷 nan-data 中，首次启动自动建表。

# --- Web entry port (nginx -> Vue app) / Web 入口端口（nginx -> 前端）---
# Open this port in the firewall / 防火墙需放行此端口。
FRONTEND_PORT=8080

# --- Optional: default remote LLM API key / 可选：默认远程大模型 Key ---
# Leave empty to configure models later in the web UI (模型配置 page).
# 留空即可，之后在网页「模型配置」页面填写；不要把真实 Key 写在这里并提交。
DEEPSEEK_API_KEY=
