# syntax=docker/dockerfile:1
# =====================================================================
# Dockerfile for the Vue 3 + Vite frontend / Vue3 + Vite 前端镜像
# Multi-stage: Node build -> static files served by nginx
# 多阶段构建：Node 构建 -> 由 nginx 托管静态文件，并反代后端接口
#
# Build context = repository root / 构建上下文 = 仓库根目录
# Build / 构建:
#   docker build -f docker/Dockerfile.frontend -t nan-novel-frontend .
#
# Build args (baked in at "npm run build" by Vite) /
# 构建参数（Vite 在 npm run build 时固化进静态产物）:
#   VITE_API_BASE_URL  Java backend prefix / Java 后端路径前缀
#   VITE_AI_BASE_URL   Python AI service prefix / Python AI 服务路径前缀
# They must be non-empty: frontend/src/api/request.js falls back to
# http://localhost:8022 / :8021 when empty.
# 必须非空：为空时前端 request.js 会回退到 localhost:8022/:8021。
# =====================================================================

# ---------- Stage 1: build static assets / 构建静态资源 ----------
FROM node:20-alpine AS build
WORKDIR /build

# Same-origin prefixes; nginx strips /java and /ai when proxying.
# 同源前缀；nginx 反代时会去掉 /java 与 /ai 前缀。
ARG VITE_API_BASE_URL=/java
ARG VITE_AI_BASE_URL=/ai
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_AI_BASE_URL=${VITE_AI_BASE_URL}

# Install deps from the lockfile first for better layer caching.
# 先依据 lock 文件安装依赖，提升缓存命中率。
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

# Build (no public/ dir exists in this project; Vite works without it).
# 构建（本项目无 public/ 目录，Vite 缺省即可正常构建）。
COPY frontend/index.html ./index.html
COPY frontend/vite.config.js ./vite.config.js
COPY frontend/src ./src
RUN npm run build

# ---------- Stage 2: nginx runtime / nginx 运行阶段 ----------
FROM nginx:1.27-alpine AS runtime

# Replace the default site config.
# 替换默认站点配置。
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

# Static assets produced by Vite.
# Vite 构建出的静态资源。
COPY --from=build /build/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
