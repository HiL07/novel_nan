# syntax=docker/dockerfile:1
# =====================================================================
# Dockerfile for the Python AI service — GPU / CUDA variant (OPTIONAL)
# Python AI 服务 GPU/CUDA 版镜像（可选）
#
# Adds PyTorch (CUDA 12.4) + transformers/peft/bitsandbytes so that local
# inference and LoRA / QLoRA fine-tuning work INSIDE the container.
# 在精简版基础上增加 PyTorch（CUDA 12.4）与 transformers/peft/
# bitsandbytes，使容器内可进行本机推理与 LoRA/QLoRA 微调。
#
# Build context = repository root / 构建上下文 = 仓库根目录
# Build / 构建:
#   docker build -f docker/Dockerfile.python-gpu -t nan-novel-python-gpu .
#
# Requirements / 运行前提:
#   - NVIDIA GPU driver on the HOST (Linux: NVIDIA Container Toolkit;
#     Windows: Docker Desktop with WSL2 + latest NVIDIA driver).
#     宿主机需有 NVIDIA 驱动（Linux 装 NVIDIA Container Toolkit；
#     Windows 用 Docker Desktop + WSL2 + 最新 NVIDIA 驱动）。
#   - Run via: docker compose -f compose.yaml -f compose.gpu.yaml up -d
#
# WARNING / 注意:
#   This image downloads several GB of wheels and is NOT built by the
#   default compose stack. It cannot be verified in environments without
#   a GPU / NVIDIA container runtime.
#   本镜像需下载数 GB 依赖，默认 compose 不会构建它；无 GPU 或未配置
#   NVIDIA 容器运行时的环境无法验证其功能。
# =====================================================================

FROM python:3.11-slim AS runtime
WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    LOCAL_MODELS_DIR=/data/models

# 1) Lightweight service deps / 轻量服务依赖
COPY python-service/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# 2) CUDA build of PyTorch 2.6 (cu124), matching requirements-local.txt.
#    安装 CUDA 12.4 版 PyTorch 2.6（与 requirements-local.txt 一致）。
#    Official index / 官方源:
RUN pip install --no-cache-dir "torch==2.6.0" --index-url https://download.pytorch.org/whl/cu124
#    China mirror alternative (uncomment to replace the line above) /
#    国内可改用阿里云镜像（取消下面注释，替换上一行）:
# RUN pip install --no-cache-dir "torch==2.6.0+cu124" -f https://mirrors.aliyun.com/pytorch-wheels/cu124/

# 3) Training / inference stack / 训练与推理依赖
COPY python-service/requirements-local.txt /tmp/requirements-local.txt
RUN pip install --no-cache-dir -r /tmp/requirements-local.txt

# Application package / 应用代码
COPY python-service/app ./app

RUN mkdir -p /data/models \
    && groupadd --system pyapp && useradd --system --gid pyapp --uid 10002 pyapp \
    && chown -R pyapp:pyapp /data/models
USER pyapp

EXPOSE 8021

# nvidia-container-toolkit injects nvidia-smi; health only proves the HTTP
# API is up (GPU visibility should be checked on the 本地模型 system page).
# nvidia-container-toolkit 会注入 nvidia-smi；本健康检查只验证 HTTP 服务，
# GPU 是否可见请到「本地模型 - 系统信息」页面确认。
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8021/api/health', timeout=5).status==200 else 1)" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8021"]
