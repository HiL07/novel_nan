# 构建产物 / 依赖
frontend/node_modules/
frontend/dist/
backend/target/

# 运行时用户上传文件（见 CLAUDE.md：不入库）
backend/upload/

# Python AI 服务
python-service/.venv/
__pycache__/
*.pyc

start.zip

# 本机私密配置（API Key 等），绝不入库
application-secret.yml
.env

# 本地模型权重、LoRA 适配器、训练任务与样本（体积大 / 含个人写作样本），绝不入库
python-service/models/

# 本机选定的 Python 解释器路径（由「Python 环境」页检测通过后写入，start.bat 读取）
python-service/.python-env

# 小说生成工作区（生成的正文、章节摘要），绝不入库
python-service/novels/

# 本地打包的 Docker 配置（内含 docker/.env 明文密钥），绝不入库
docker.zip

# 共享数据目录：SQLite 数据库、上传文件、提取结果、生成的小说等用户数据，绝不入库（只保留说明文件）
data/*
!data/.gitkeep
!data/README.md

# 本机迁移记录（只留在本地）
迁移说明.txt
